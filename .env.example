# URL of the Worker in backend/. Leave unset for a fully local editor.
VITE_UPLOAD_API_URL=http://127.0.0.1:8787

# For a deployed build, set this in .env.production.local to your presign Worker:
# VITE_UPLOAD_API_URL=https://your-presign-worker.your-subdomain.workers.dev

# Optional. Self-host the single-thread ffmpeg.wasm core and point this at its
# ESM directory. If unset, the media lab lazily fetches the official npm build
# from jsDelivr.
VITE_FFMPEG_CORE_BASE_URL=https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.10/dist/esm
