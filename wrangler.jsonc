{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visually-image-editor",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "visually.deeeplearn.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
